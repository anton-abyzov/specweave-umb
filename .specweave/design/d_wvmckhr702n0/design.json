        {
          "id": "board",
          "parentId": "n_sanyae52oo7y",
          "name": "Copy progress board",
          "x": 0,
          "y": 0,
          "width": 1440,
          "height": 1024,
          "type": "html",
          "html": "<style>\n.b{--bg:#fcfcfb;--card:#fff;--fg:#27272a;--muted:#fafafa;--track:#f0f0f1;--mfg:#71717a;--border:#e4e4e7;--primary:oklch(0.511 0.155 293.7);--ok:#10b981;--okfg:#047857;--err:#ef4444;--errfg:#b91c1c;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",system-ui,sans-serif;color:var(--fg);background:var(--bg);width:1440px;height:1024px;box-sizing:border-box;padding:56px 64px;display:grid;grid-template-columns:620px 1fr;gap:40px 64px}\n.b *{box-sizing:border-box}\nh2{font-size:13px;font-weight:600;margin:0 0 4px}\n.cap{font-size:12px;color:var(--mfg);margin:0 0 14px;max-width:560px;line-height:1.45}\n.panel{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin-bottom:18px}\n.top{display:flex;align-items:baseline;justify-content:space-between}\n.step{font-size:14px;font-weight:500}\n.pct{font-size:30px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.02em}.pct small{font-size:13px;color:var(--mfg);font-weight:500;margin-left:2px}\n.track{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin:12px 0 6px}\n.seg{position:relative;height:8px;border-radius:99px;background:var(--track);overflow:hidden}\n.fill{position:absolute;inset:0 auto 0 0;border-radius:99px;background:var(--primary)}\n.sheen{position:absolute;inset:0;background:linear-gradient(90deg,transparent 0,rgba(255,255,255,.55) 50%,transparent 100%);width:40%;left:30%}\n.ok .fill{background:var(--ok)} .bad{background:var(--err)}\n.notch{position:absolute;top:-3px;width:2px;height:14px;background:var(--err);border-radius:1px;box-shadow:0 0 0 4px rgba(239,68,68,.18)}\n.labels{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;font-size:12px;color:var(--mfg);line-height:1.35}\n.labels b{color:var(--fg);font-weight:600}.labels .c::before{content:\"✓ \";color:var(--mfg)}.labels .xf{color:var(--errfg)}.labels .xf::before{content:\"✕ \"}\n.okl .c::before{color:var(--okfg)}\n.nums{display:flex;gap:18px;font-size:12px;margin-top:10px;font-variant-numeric:tabular-nums}.nums span:not(:first-child){color:var(--mfg)}\n.btns{display:flex;gap:8px;justify-content:flex-end;margin-top:14px}\n.btn{font-size:13px;font-weight:500;height:32px;padding:0 12px;border-radius:8px;display:inline-flex;align-items:center;border:1px solid var(--border);background:var(--card)}\n.btn.p{background:var(--primary);color:#fff;border-color:transparent}\n.note{font-size:11.5px;color:var(--mfg);line-height:1.45;border-left:2px solid var(--err);padding:2px 0 2px 10px;margin:8px 0 0}\n.toast{width:360px;background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 24px -8px rgba(24,24,27,.18);padding:12px 14px;margin-bottom:12px;position:relative}\n.toast .t{display:flex;gap:8px;font-size:13px;font-weight:600;align-items:center}\n.toast .d{font-size:12px;color:var(--mfg);margin:4px 0 0 24px;line-height:1.45}\n.toast .track{margin:10px 0 0 24px;gap:3px}.toast .seg{height:4px}\n.toast .act{display:flex;justify-content:flex-end;margin-top:8px}\n.toast .btn{height:26px;font-size:12px;border-radius:7px;padding:0 10px}\n.ic{width:16px;height:16px;border-radius:99px;display:inline-grid;place-items:center;font-size:10px;color:#fff}\n.close{position:absolute;right:8px;top:8px;color:var(--mfg);font-size:12px}\n.banner{background:var(--muted);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:13px}\n.banner .track{gap:2px;margin:8px 0 6px}.banner .seg{height:4px}\n.side{width:260px;background:#f4f4f5;border-radius:10px;padding:8px;margin-top:12px}\n.row{position:relative;height:30px;border-radius:7px;display:flex;align-items:center;padding:0 10px;font-size:13px;color:var(--mfg)}\n.row.on{background:#fff;color:var(--fg)}\n.line{position:absolute;left:8px;right:8px;bottom:2px;display:grid;grid-template-columns:repeat(3,1fr);gap:2px}\n.line i{height:2px;border-radius:1px;background:#d4d4d8;position:relative;overflow:hidden}.line i b{position:absolute;inset:0 auto 0 0;background:var(--primary)}\n.motion{grid-column:1/3;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;border-top:1px solid var(--border);padding-top:20px}\n.motion div{font-size:12px;color:var(--mfg);line-height:1.5}.motion b{display:block;color:var(--fg);font-size:12.5px;margin-bottom:2px}\n</style>\n<div class=\"b\">\n<div>\n <h2>Copy dialog</h2><p class=\"cap\">One track, three phases named by the machine doing them. The active segment carries a slow sheen while bytes move; it stops when the copy stalls.</p>\n <div class=\"panel\">\n  <div class=\"top\"><span class=\"step\">Sending files to m5</span><span class=\"pct\">44<small>%</small></span></div>\n  <div class=\"track\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:32%\"></div><div class=\"sheen\" style=\"left:2%;width:28%\"></div></div><div class=\"seg\"></div></div>\n  <div class=\"labels\"><span class=\"c\">Measure<br>on m4</span><span><b>Send</b><br>to m5</span><span>Apply<br>on m5</span></div>\n  <div class=\"nums\"><span>2.4 GB of 7.5 GB</span><span>39,120 of 121,868 files</span><span>48 MB/s</span><span>About 1 min 50 s left</span></div>\n  <div class=\"btns\"><span class=\"btn\">Run in background</span><span class=\"btn\">Stop</span></div>\n </div>\n <div class=\"panel okl\">\n  <div class=\"top\"><span class=\"step\">Copied to m5</span><span class=\"pct\" style=\"color:var(--okfg)\">100<small>%</small></span></div>\n  <div class=\"track ok\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div></div>\n  <div class=\"labels\"><span class=\"c\">Measure<br>on m4</span><span class=\"c\">Send<br>to m5</span><span class=\"c\">Apply<br>on m5</span></div>\n  <div class=\"nums\"><span>7.5 GB</span><span>121,868 files</span><span>in 3 min 12 s</span></div>\n  <div class=\"btns\"><span class=\"btn p\">Open on m5</span></div>\n </div>\n <div class=\"panel\">\n  <div class=\"top\"><span class=\"step\">Stopped while sending to m5</span><span class=\"pct\">41<small>%</small></span></div>\n  <div class=\"track\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\" style=\"overflow:visible\"><div class=\"fill bad\" style=\"width:41%\"></div><div class=\"notch\" style=\"left:calc(41% - 1px)\"></div></div><div class=\"seg\"></div></div>\n  <div class=\"labels\"><span class=\"c\">Measure<br>on m4</span><span class=\"xf\">Send<br>to m5</span><span>Apply<br>on m5</span></div>\n  <p class=\"note\">m4 stopped answering over Connect for 2 minutes. Retry picks up here; the 3.1 GB already on m5 is kept.</p>\n  <div class=\"btns\"><span class=\"btn\">Close</span><span class=\"btn p\">Retry</span></div>\n </div>\n</div>\n<div>\n <h2>In the background</h2><p class=\"cap\">Closing the dialog leaves three views of the same copy: the toast, the project banner and the sidebar line. All three use the same three segments.</p>\n <div class=\"toast\"><span class=\"close\">✕</span><div class=\"t\"><span class=\"ic\" style=\"background:var(--primary)\">↗</span>Copy to m5: 44% done</div><div class=\"d\">Sending files to m5. 5.1 GB and 82,545 files left, about 1 min 50 s left.</div>\n  <div class=\"track\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:32%\"></div><div class=\"sheen\" style=\"left:2%;width:28%\"></div></div><div class=\"seg\"></div></div><div class=\"act\"><span class=\"btn\">Details</span></div></div>\n <div class=\"toast\"><span class=\"close\">✕</span><div class=\"t\"><span class=\"ic\" style=\"background:var(--ok)\">✓</span>Copy to m1 is done</div><div class=\"d\">7.5 GB in 3 min 12 s. Open it to finish setting it up.</div>\n  <div class=\"track ok\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div></div><div class=\"act\"><span class=\"btn p\">Open</span></div></div>\n <div class=\"toast\"><span class=\"close\">✕</span><div class=\"t\"><span class=\"ic\" style=\"background:var(--err)\">!</span>Copy to linux-box stopped</div><div class=\"d\">m4 stopped answering over Connect for 2 minutes. Retry keeps the files already copied.</div><div class=\"act\"><span class=\"btn p\">Retry</span></div></div>\n <div class=\"banner\"><div>Copy to m5: sending files to m5</div><div class=\"track\"><div class=\"seg\"><div class=\"fill\" style=\"width:100%\"></div></div><div class=\"seg\"><div class=\"fill\" style=\"width:32%\"></div></div><div class=\"seg\"></div></div><div style=\"font-size:12px;color:var(--mfg)\">2.4 GB of 7.5 GB &nbsp; 48 MB/s &nbsp; About 1 min 50 s left</div></div>\n <div class=\"side\"><div class=\"row\">vskill</div><div class=\"row on\">specweave<div class=\"line\"><i><b style=\"width:100%\"></b></i><i><b style=\"width:32%\"></b></i><i></i></div></div><div class=\"row\">easychamp</div></div>\n</div>\n<div class=\"motion\">\n <div><b>Fill</b>Width eases with the app curve (ease-out-quint, 600 ms), so 2 s polls read as one continuous movement, not jumps.</div>\n <div><b>Phase change</b>The finished segment's label gets its check (scale 0.6 to 1, 180 ms); the next label turns bold. Nothing else moves.</div>\n <div><b>Done</b>One sweep: the three segments turn emerald left to right, 80 ms apart, and the toast icon draws in. The single orchestrated moment.</div>\n <div><b>Stopped</b>The fill stays where it stopped and turns red. A notch marks the spot and pulses once. No shake. Reduced motion: colours change, nothing moves.</div>\n</div>\n</div>"
        }
      ]
    }
