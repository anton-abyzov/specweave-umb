{
  "version": "2.0",
  "adapters": {
    "default": "claude"
  },
  "repository": {
    "provider": "local"
  },
  "issueTracker": {
    "provider": "jira",
    "domain": "antonabyzov.atlassian.net",
    "projects": [
      {
        "key": "SWE2E",
        "id": "10139",
        "name": "SpecWeave E2E Test"
      },
      {
        "key": "WTTC",
        "id": "10106",
        "name": "WC2026 Travel & Ticket Companion"
      }
    ]
  },
  "testing": {
    "mode": "TDD",
    "coverage": {
      "unit": 60,
      "integration": 90,
      "e2e": 100
    }
  },
  "limits": {
    "activeIncrements": 7
  },
  "hooks": {
    "post_increment_done": {
      "sync_to_github_project": true,
      "close_github_issue": true
    }
  },
  "sync": {
    "enabled": true,
    "direction": "bidirectional",
    "autoSync": true,
    "includeStatus": true,
    "autoApplyLabels": true,
    "preset": "bidirectional",
    "provider": "jira",
    "defaultProfile": "jira-swe2e",
    "settings": {
      "canUpsertInternalItems": true,
      "canUpdateExternalItems": true,
      "canUpdateStatus": true,
      "autoSyncOnCompletion": true
    },
    "profiles": {
      "jira-swe2e": {
        "platform": "jira",
        "config": {
          "domain": "antonabyzov.atlassian.net",
          "projectKey": "SWE2E",
          "projectId": "10139"
        }
      },
      "jira-wttc": {
        "platform": "jira",
        "config": {
          "domain": "antonabyzov.atlassian.net",
          "projectKey": "WTTC"
        }
      }
    },
    "github": {
      "enabled": true,
      "owner": "anton-abyzov",
      "repo": "specweave"
    },
    "jira": {
      "enabled": true,
      "domain": "antonabyzov.atlassian.net",
      "projectKey": "SWE2E"
    },
    "ado": {
      "enabled": true,
      "organization": "EasyChamp",
      "project": "SpecWeaveSync"
    }
  },
  "planning": {
    "deepInterview": "warn"
  },
  "cicd": {
    "pushStrategy": "direct",
    "git": {
      "branchPrefix": "sw/",
      "targetBranch": "main",
      "deleteOnMerge": true,
      "includeExternalKey": false
    },
    "autoFix": {
      "enabled": true,
      "maxRetries": 1,
      "allowedBranches": [
        "develop",
        "main"
      ]
    }
  },
  "project": {
    "name": "specweave",
    "version": "1.0.1"
  },
  "auto": {
    "enabled": true,
    "maxRetries": 20,
    "requireTests": true,
    "requireValidation": true,
    "requireJudgeLLM": false,
    "skipQualityGates": false
  },
  "lsp": {
    "enabled": true,
    "autoInstallPlugins": true,
    "marketplace": "boostvolt/claude-code-lsps"
  },
  "workspace": {
    "name": "specweave-umb",
    "repos": [
      {
        "id": "specweave",
        "path": "repositories/anton-abyzov/specweave",
        "prefix": "SPE",
        "name": "specweave",
        "sync": {
          "github": {
            "owner": "anton-abyzov",
            "repo": "specweave"
          },
          "jira": {
            "projectKey": "SWE2E"
          },
          "ado": {
            "project": "SpecWeaveSync",
            "organization": "EasyChamp"
          }
        }
      },
      {
        "id": "vskill",
        "path": "repositories/anton-abyzov/vskill",
        "prefix": "VSK",
        "name": "vskill",
        "sync": {
          "github": {
            "owner": "anton-abyzov",
            "repo": "vskill"
          },
          "jira": {
            "projectKey": "SWE2E"
          },
          "ado": {
            "project": "SpecWeaveSync",
            "organization": "EasyChamp"
          }
        }
      },
      {
        "id": "vskill-platform",
        "path": "repositories/anton-abyzov/vskill-platform",
        "prefix": "VPL",
        "name": "vskill-platform",
        "sync": {
          "github": {
            "owner": "anton-abyzov",
            "repo": "vskill-platform"
          },
          "jira": {
            "projectKey": "SWE2E"
          },
          "ado": {
            "project": "SpecWeaveSync",
            "organization": "EasyChamp"
          }
        }
      }
    ],
    "rootRepo": {
      "github": {
        "owner": "anton-abyzov",
        "repo": "specweave-umb"
      },
      "jira": {
        "projectKey": "SWE2E"
      },
      "ado": {
        "project": "SpecWeaveSync",
        "organization": "EasyChamp"
      }
    }
  },
  "livingDocs": "onDone",
  "jev": {
    "enabled": true,
    "provider": "openrouter",
    "model": "jev-1.13",
    "guards": {
      "bash": true
    }
  }
}
